@page "/schedule"

<PageTitle>Schedule</PageTitle>

<h1>Work Schedule</h1>

<p>Графік робочий.</p>

<div class="card bg-dark text-light border-secondary mb-3">
    <div class="card-body">
        <div class="d-flex justify-content-between mb-2">
            <span>Monday</span>
            <span class="text-success">Work</span>
        </div>
        <div class="d-flex justify-content-between mb-2">
            <span>Tuesday</span>
            <span class="text-success">Work</span>
        </div>
        <div class="d-flex justify-content-between mb-2">
            <span>Wednesday</span>
            <span class="text-success">Work</span>
        </div>
        <div class="d-flex justify-content-between mb-2">
            <span>Thursday</span>
            <span class="text-secondary">Rest</span>
        </div>
        <div class="d-flex justify-content-between mb-2">
            <span>Friday</span>
            <span class="text-secondary">Rest</span>
        </div>
    </div>
</div>
