@page "/finance"

<PageTitle>Finance</PageTitle>

<h1>Finance</h1>

<p>Статистика грошей.</p>

<PixelCard Title="FINANCE" Subtitle="(Monobank/Pumb)">
    <div class="row align-items-center mb-4">
        <div class="col-auto">
            <div style="font-size: 48px;">👛</div>
        </div>
        <div class="col">
            <div class="d-flex justify-content-between mb-3">
                <span style="color: #d4a5ff;">Monobank:</span>
                <span class="text-success">25,430 UAH</span>
            </div>
            <div class="d-flex justify-content-between">
                <span style="color: #d4a5ff;">Pumb:</span>
                <span class="text-success">18,200 UAH</span>
            </div>
        </div>
    </div>
</PixelCard>

<PixelCard Title="PUMB" TitleOverlay="true">
    <div class="d-flex align-items-center mb-3">
        <div class="bg-danger rounded p-3 me-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
            <span class="text-white fw-bold">mob</span>
        </div>
        <div>
            <h4 class="mb-0">Pumb</h4>
            <span class="text-muted">Pumb</span>
        </div>
    </div>
    
    <div class="d-flex justify-content-between mb-2">
        <span style="color: #d4a5ff;">Monobank:</span>
        <span class="text-success">25,430 UAH</span>
        <span class="text-secondary">U&M</span>
    </div>
    <div class="d-flex justify-content-between mb-2">
        <span style="color: #d4a5ff;">Henash:</span>
        <span class="text-success">25,430 UAH</span>
        <span class="text-secondary">U&M</span>
    </div>
    <div class="d-flex justify-content-between mb-2">
        <span style="color: #d4a5ff;">Pumb:</span>
        <span class="text-success">25,200 UAH</span>
        <span class="text-secondary">U&M</span>
    </div>
    <div class="d-flex justify-content-between">
        <span style="color: #d4a5ff;">Pumb:</span>
        <span class="text-success">18,200 UAH</span>
        <span class="text-secondary">U&M</span>
    </div>
</PixelCard>
