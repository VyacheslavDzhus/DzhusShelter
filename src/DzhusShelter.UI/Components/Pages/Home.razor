</div>

<style>
    .hero-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 1rem;
        margin-bottom: 2rem;
    }

    .ascii-banner {
        color: #ffffff;
        text-shadow: 2px 2px 0px #000, 3px 3px 0px #209cee;
        font-family: 'Courier New', Courier, monospace;
        font-size: 14px;
        line-height: 1.1;
        margin: 0 0 8px 0;
        text-align: center;
    }

    .hero-sprite {
        image-rendering: pixelated;
        width: 260px;
        height: auto;
    }

    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    @@media (max-width: 768px) {
        .ascii-banner { font-size: 8px; }
        .hero-sprite { width: 180px; }
    }
</style>