@page "/bad-habits"
@rendermode InteractiveServer
@using DzhusShelter.UI.Services

<PageTitle>Bad Habits</PageTitle>

<h1>Bad Habits</h1>

<div class="bad-habits-grid">
    <ErrorBoundary>
        <ChildContent>
            <PixelHabitCard HabitType="HabitType.Alcohol" Title="Алкоголь" />
        </ChildContent>
        <ErrorContent>
            <p>Не вдалося завантажити дані. Спробуйте оновити сторінку.</p>
        </ErrorContent>
    </ErrorBoundary>
    <ErrorBoundary>
        <ChildContent>
            <PixelHabitCard HabitType="HabitType.Smoking" Title="Куріння" />
        </ChildContent>
        <ErrorContent>
            <p>Не вдалося завантажити дані. Спробуйте оновити сторінку.</p>
        </ErrorContent>
    </ErrorBoundary>
</div>
