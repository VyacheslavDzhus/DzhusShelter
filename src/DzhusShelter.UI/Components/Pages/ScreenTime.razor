@page "/screen-time"

<PageTitle>Screen Time</PageTitle>

<h1>Screen Time</h1>

<p>Екранний час.</p>

<div class="card bg-dark text-light border-secondary mb-3">
    <div class="card-body text-center">
        <h3 class="card-title">📱 Daily Screen Time</h3>
        <p class="display-3 text-info mt-4">11:00</p>
        <p class="text-muted">HOURS TODAY</p>
        <!-- Placeholder for a chart -->
        <div class="mt-4" style="height: 100px; display: flex; align-items: flex-end; justify-content: center; gap: 10px;">
            <div class="bg-info" style="width: 20px; height: 50%;"></div>
            <div class="bg-info" style="width: 20px; height: 30%;"></div>
            <div class="bg-info" style="width: 20px; height: 70%;"></div>
            <div class="bg-info" style="width: 20px; height: 40%;"></div>
            <div class="bg-info" style="width: 20px; height: 90%;"></div>
            <div class="bg-info" style="width: 20px; height: 60%;"></div>
            <div class="bg-info" style="width: 20px; height: 80%;"></div>
        </div>
    </div>
</div>
